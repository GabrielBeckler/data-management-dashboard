# Servidor
NODE_ENV=development
PORT=3001

# Banco de dados (configure conforme o provider definido no Prisma)
DATABASE_URL=

# WhatsApp
WHATSAPP_SESSION_NAME=otica
WHATSAPP_HEADLESS=true

# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/oauth2callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Horários de atendimento
CALENDAR_TIMEZONE=America/Sao_Paulo
APPOINTMENT_DURATION_MINUTES=60
APPOINTMENT_START_TIME=09:00
APPOINTMENT_END_TIME=18:00
APPOINTMENT_INTERVAL_MINUTES=30

# Pequeno intervalo entre respostas do WhatsApp (0 desativa)
WHATSAPP_RESPONSE_DELAY_MS=800
# Cron do scheduler (teste: * * * * * executa a cada minuto)
REMINDER_CRON=0 9 * * *
